set_location_assignment PIN_D19 -to enet0_tx_data[1]
set_location_assignment PIN_C18 -to enet0_tx_data[0]
set_location_assignment PIN_A18 -to enet0_tx_en
set_location_assignment PIN_B18 -to enet0_tx_er
