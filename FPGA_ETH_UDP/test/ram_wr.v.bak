module ram_wr(
    input clk,
    input rst_n,

    output ram_wr_en,
    output [10:0] ram_wr_addr,
    output [7:0] ram_wr_data
);



reg [10:0] wr_cnt;

assign ram_wr_en   =( (wr_cnt > 0) && (wr_cnt <= 11'd31)&& rst_n) ? 1'b1 : 1'b0;


always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        wr_cnt <= 0;
    end else if(wr_cnt > 11'd63) begin
            wr_cnt <= wr_cnt;
        end
        else begin
            wr_cnt <= wr_cnt + 1;
        end
    
end

// 写数据
always@(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        ram_wr_data <= 0;
    end else if(wr_cnt >= 6'd0 && wr_cnt <= 6'd31)begin
        ram_wr_data <= ram_wr_data + 1'b1;
    end else
        ram_wr_data <= 8'd0;
end

// 写地址
always@(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        ram_wr_addr <= 0;
    end else if(wr_cnt >= 6'd1 && wr_cnt <= 6'd32)begin
        ram_wr_addr <= ram_wr_addr + 1'b1;
    end else
        ram_wr_addr <= 11'd0;



endmodule