module mdio_config_ctrl (
    input  wire        clk,
    input  wire        rst_n,

    // --- Avalon-MM Master 接口 (连接到 TSE IP) ---
    output reg  [7:0]  o_av_addr,
    output reg         o_av_read,
    output reg         o_av_write,
    output reg  [31:0] o_av_writedata,
    input  wire [31:0] i_av_readdata,
    input  wire        i_av_waitrequest,

    // --- 控制 PHY 复位引脚 ---
    output reg         o_phy_rst_n
);

    // 状态定义
    localparam  S_IDLE        = 4'd0,
                S_PHY_WAKEUP  = 4'd1,
                S_SET_ADDR    = 4'd2,
                S_WAIT_WRITE  = 4'd3,
                S_READ_ID1    = 4'd4,
                S_WAIT_READ1  = 4'd5,
                S_READ_ID2    = 4'd6,
                S_WAIT_READ2  = 4'd7,
                S_CHECK       = 4'd8,
                S_CFG_MAC     = 4'd9,
                S_WAIT_CFG    = 4'd10,
                S_DONE_OK     = 4'd11;

    reg [3:0]   r_state;
    reg [19:0]  r_wait_cnt;
    reg [4:0]   r_phy_addr; // PHY 地址 0-31
    reg [31:0]  r_phy_id1;
    reg [31:0]  r_phy_id2;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            r_state        <= S_IDLE;
            r_wait_cnt     <= 0;
            o_av_read      <= 0;
            o_av_write     <= 0;
            o_av_addr      <= 0;
            o_av_writedata <= 0;
            r_phy_addr     <= 0;
            r_phy_rst_n    <= 0; // 初始复位 PHY
            r_phy_id1      <= 0;
            r_phy_id2      <= 0;
        end else begin
            // 默认拉低读写信号 (脉冲)
            o_av_read  <= 0;
            o_av_write <= 0;
            
            case (r_state)
                S_IDLE: begin
                    o_phy_rst_n <= 0; // 保持 PHY 复位
                    if (r_wait_cnt < 20'd500_000) 
                        r_wait_cnt <= r_wait_cnt + 1;
                    else begin 
                        r_wait_cnt <= 0; 
                        r_state <= S_PHY_WAKEUP; 
                    end
                end

                S_PHY_WAKEUP: begin
                    o_phy_rst_n <= 1; // 释放 PHY 复位
                    // 等待 PHY 内部电路稳定
                    if (r_wait_cnt < 20'd500_000) 
                        r_wait_cnt <= r_wait_cnt + 1;
                    else 
                        r_state <= S_SET_ADDR;
                end

                // 1. 配置 TSE IP 内部的 MDIO 地址寄存器 (Offset 0x0F)
                // 告诉 IP 核我们要访问哪个 PHY 地址
                S_SET_ADDR: begin 
                    o_av_write     <= 1; 
                    o_av_addr      <= 8'h0F; // mdio_addr0
                    o_av_writedata <= {27'b0, r_phy_addr}; 
                    r_state        <= S_WAIT_WRITE;
                end

                S_WAIT_WRITE: begin
                    o_av_write <= 1; // 保持直到 waitrequest 变低
                    if (!i_av_waitrequest) begin 
                        o_av_write <= 0; 
                        r_state <= S_READ_ID1; 
                    end
                end

                // 2. 读取 PHY ID Register 1 (Offset 0x82 -> PHY Reg 2)
                S_READ_ID1: begin
                    o_av_read <= 1; 
                    o_av_addr <= 8'h82; 
                    r_state   <= S_WAIT_READ1;
                end

                S_WAIT_READ1: begin
                    o_av_read <= 1;
                    if (!i_av_waitrequest) begin 
                        r_phy_id1 <= i_av_readdata; 
                        o_av_read <= 0; 
                        r_state <= S_READ_ID2; 
                    end
                end

                // 3. 读取 PHY ID Register 2 (Offset 0x83 -> PHY Reg 3)
                S_READ_ID2: begin
                    o_av_read <= 1; 
                    o_av_addr <= 8'h83; 
                    r_state   <= S_WAIT_READ2;
                end

                S_WAIT_READ2: begin
                    o_av_read <= 1;
                    if (!i_av_waitrequest) begin 
                        r_phy_id2 <= i_av_readdata; 
                        o_av_read <= 0; 
                        r_state <= S_CHECK; 
                    end
                end

                // 4. 检查是否读到了有效的 ID
                S_CHECK: begin
                    // 如果读全是 1 (FFFF)，说明这个地址没有 PHY 响应
                    if ((r_phy_id1[15:0] == 16'hFFFF) && (r_phy_id2[15:0] == 16'hFFFF)) begin
                        if (r_phy_addr < 31) begin 
                            r_phy_addr <= r_phy_addr + 1; // 换下一个地址试
                            r_state <= S_SET_ADDR; 
                        end else begin
                            // 扫描完了都没找到... (可以在这里加个LED报错)
                            // 这里暂时死循环或重来
                            r_phy_addr <= 0;
                            r_state <= S_SET_ADDR;
                        end
                    end else begin
                        // 找到了！(ID 不是全 F) -> 去配置 MAC
                        r_state <= S_CFG_MAC;
                    end
                end
                
                // 5. 配置 command_config (Offset 0x02)
                // 开启 TX_ENA (bit 0) 和 RX_ENA (bit 1)
                S_CFG_MAC: begin
                    o_av_write     <= 1; 
                    o_av_addr      <= 8'h02; 
                    o_av_writedata <= 32'h00000003; // 0x03
                    r_state        <= S_WAIT_CFG;
                end

                S_WAIT_CFG: begin
                    o_av_write <= 1;
                    if (!i_av_waitrequest) begin 
                        o_av_write <= 0; 
                        r_state <= S_DONE_OK; 
                    end
                end

                S_DONE_OK: begin
                    // 配置完成，状态机停在这里
                    r_state <= S_DONE_OK;
                end
                
                default: r_state <= S_IDLE;
            endcase
        end
    end

endmodule